# =============================================
# MT5 BROKER CREDENTIALS
# =============================================
# XM Global demo örneği. Kendi hesabını yaz.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# (opsiyonel) MT5 terminal.exe'nin tam yolu. Boş bırakırsan default yol kullanılır
MT5_PATH=

# =============================================
# STRATEGY DEFAULTS (production: USDSEK M30)
# =============================================
SYMBOL=USDSEK
TIMEFRAME=M30
LOT_SIZE=0.01
MAX_CONCURRENT_POSITIONS=2
MAX_DAILY_LOSS_PCT=2.0

# =============================================
# MODEL
# =============================================
MODEL_PATH=models/lnn_usdsek_m30.pt
SEQ_LEN=60
PRED_HORIZON=5

# =============================================
# TELEGRAM NOTIFICATIONS (opsiyonel)
# =============================================
# Bot oluştur: @BotFather → /newbot → TOKEN al
# Chat ID al: bot ile mesajlaş, sonra https://api.telegram.org/bot<TOKEN>/getUpdates aç
# Boş bırakırsan bildirim sistemi devre dışı kalır (bot yine de çalışır)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
